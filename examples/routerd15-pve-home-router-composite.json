{
  "apiVersion": "routerd.net/v1alpha1",
  "kind": "Router",
  "metadata": {"name": "pve-home-router-composite"},
  "spec": {"resources": [
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"Interface","metadata":{"name":"lan"},"spec":{"ifname":"rd15-lan","managed":false,"owner":"external"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"Interface","metadata":{"name":"wan"},"spec":{"ifname":"rd15-wan","managed":false,"owner":"external"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv4StaticAddress","metadata":{"name":"lan-v4"},"spec":{"interface":"lan","address":"198.18.15.1/24"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv4StaticAddress","metadata":{"name":"wan-v4"},"spec":{"interface":"wan","address":"198.18.16.2/24"}},
    {"apiVersion":"system.routerd.net/v1alpha1","kind":"Sysctl","metadata":{"name":"forward-v4"},"spec":{"key":"net.ipv4.ip_forward","value":"1"}},
    {"apiVersion":"system.routerd.net/v1alpha1","kind":"Sysctl","metadata":{"name":"forward-v6"},"spec":{"key":"net.ipv6.conf.all.forwarding","value":"1"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv4Route","metadata":{"name":"default-v4"},"spec":{"destination":"0.0.0.0/0","device":"rd15-wan","gateway":"198.18.16.1"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"NAT44Rule","metadata":{"name":"lan-to-wan"},"spec":{"type":"masquerade","egressInterface":"wan","sourceRanges":["198.18.15.0/24"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DHCPv4Server","metadata":{"name":"lan"},"spec":{"interface":"lan","addressPool":{"start":"198.18.15.100","end":"198.18.15.110","leaseTime":"90s"},"gatewayFrom":{"resource":"IPv4StaticAddress/lan-v4","field":"address"},"dnsServerFrom":[{"resource":"IPv4StaticAddress/lan-v4","field":"address"}],"domainFrom":{"resource":"DNSZone/home","field":"zone"}}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DHCPv6PrefixDelegation","metadata":{"name":"wan-pd"},"spec":{"interface":"wan","profile":"default","prefixLength":60}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DHCPv6Information","metadata":{"name":"wan-info"},"spec":{"interface":"wan"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv6DelegatedAddress","metadata":{"name":"lan-v6"},"spec":{"prefixDelegation":"wan-pd","interface":"lan","subnetID":"0","addressSuffix":"::1","announce":true}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv6RouterAdvertisement","metadata":{"name":"lan-ra"},"spec":{"interface":"lan","prefixFrom":{"resource":"IPv6DelegatedAddress/lan-v6","field":"address"},"rdnssFrom":[{"resource":"IPv6DelegatedAddress/lan-v6","field":"address"}],"routerLifetime":"30"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSResolver","metadata":{"name":"lan"},"spec":{"listen":[{"name":"lan-v4","addresses":["198.18.15.1"],"port":53},{"name":"lan-v6","addressFrom":[{"resource":"IPv6DelegatedAddress/lan-v6","field":"address"}],"port":53}],"cache":{"enabled":false}}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSZone","metadata":{"name":"home"},"spec":{"zone":"home.test","records":[{"hostname":"router","ipv4":"198.18.15.1","ipv6From":{"resource":"IPv6DelegatedAddress/lan-v6","field":"address"}}]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSForwarder","metadata":{"name":"home"},"spec":{"resolver":"DNSResolver/lan","match":["home.test"],"zoneRefs":["DNSZone/home"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSForwarder","metadata":{"name":"ipv4-peer"},"spec":{"resolver":"DNSResolver/lan","match":["v4.test"],"upstreams":["DNSUpstream/wan-v4-dns"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSForwarder","metadata":{"name":"ipv6-peer"},"spec":{"resolver":"DNSResolver/lan","match":["info.test"],"upstreams":["DNSUpstream/wan-info-dns"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSUpstream","metadata":{"name":"wan-v4-dns"},"spec":{"protocol":"udp","address":"198.18.16.1","sourceInterface":"wan"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSUpstream","metadata":{"name":"wan-info-dns"},"spec":{"protocol":"udp","addressFrom":[{"resource":"DHCPv6Information/wan-info","field":"dnsServers"}],"sourceInterface":"wan"}},
    {"apiVersion":"firewall.routerd.net/v1alpha1","kind":"FirewallZone","metadata":{"name":"lan"},"spec":{"role":"trust","interfaces":["lan"]}},
    {"apiVersion":"firewall.routerd.net/v1alpha1","kind":"FirewallZone","metadata":{"name":"wan"},"spec":{"role":"untrust","interfaces":["wan"]}},
    {"apiVersion":"firewall.routerd.net/v1alpha1","kind":"FirewallPolicy","metadata":{"name":"default"},"spec":{"logDeny":true}}
  ]}
}
