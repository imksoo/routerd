#!/bin/sh
set -e
if [ "$1" = remove ]; then
    # Remove only generated units and links resolving to those exact files.
    # This also works offline; drop-ins and persistent data are left untouched.
    for unit in /etc/systemd/system/*.service; do
        if [ ! -f "$unit" ] || [ -L "$unit" ]; then continue; fi
        grep -qx '# routerd-managed-service: v1' "$unit" || continue
        find /etc/systemd/system /run/systemd/system -type l -print 2>/dev/null |
            while IFS= read -r link; do
                if [ "$(readlink -m "$link")" = "$unit" ]; then
                    rm -f "$link"
                fi
            done
        rm -f "$unit"
    done
    # Packaged units may already be gone when postrm runs.
    find /etc/systemd/system /run/systemd/system -type l -print 2>/dev/null |
        while IFS= read -r link; do
            case "$(readlink -m "$link")" in
                /etc/systemd/system/routerd.service|/etc/systemd/system/routerd.slice|\
                /usr/lib/systemd/system/routerd.service|/usr/lib/systemd/system/routerd.slice)
                    rm -f "$link" ;;
            esac
        done
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
