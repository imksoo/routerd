{
  "apiVersion": "routerd.net/v1alpha1",
  "kind": "Router",
  "metadata": {
    "name": "dhcpv6-implicit-ra-ra-only-smoke"
  },
  "spec": {
    "resources": [
      {
        "apiVersion": "net.routerd.net/v1alpha1",
        "kind": "Interface",
        "metadata": {
          "name": "lan"
        },
        "spec": {
          "ifname": "rd15-lan",
          "managed": false,
          "owner": "external"
        }
      },
      {
        "apiVersion": "net.routerd.net/v1alpha1",
        "kind": "DHCPv6Server",
        "metadata": {
          "name": "lan-dhcpv6"
        },
        "spec": {
          "interface": "lan",
          "mode": "ra-only",
          "defaultRoute": true,
          "dnsSource": "none"
        }
      }
    ]
  }
}
