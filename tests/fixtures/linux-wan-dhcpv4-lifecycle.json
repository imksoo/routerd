{
  "apiVersion": "routerd.net/v1alpha1",
  "kind": "Router",
  "metadata": {"name": "wan-readiness"},
  "spec": {"resources": [
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"Interface","metadata":{"name":"lan"},"spec":{"ifname":"rd15-lan","managed":false,"owner":"external"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"IPv4StaticAddress","metadata":{"name":"lan-v4"},"spec":{"interface":"lan","address":"198.18.45.1/24"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"Interface","metadata":{"name":"wan"},"spec":{"ifname":"rd15-wan","managed":false,"owner":"external"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DHCPv4Client","metadata":{"name":"wan"},"spec":{"interface":"wan","hostname":"rd15-wan","useRoutes":true,"useDNS":true,"routeMetric":4242}},
    {"apiVersion":"system.routerd.net/v1alpha1","kind":"Sysctl","metadata":{"name":"forward-v4"},"spec":{"key":"net.ipv4.ip_forward","value":"1"}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"NAT44Rule","metadata":{"name":"lan-to-wan"},"spec":{"type":"masquerade","egressInterface":"wan","sourceRanges":["198.18.45.0/24"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSResolver","metadata":{"name":"lan"},"spec":{"listen":[{"name":"lan","addresses":["198.18.45.1"],"port":53,"sources":["upstream"]}],"cache":{"enabled":false}}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSForwarder","metadata":{"name":"upstream"},"spec":{"resolver":"DNSResolver/lan","match":["."],"upstreams":["DNSUpstream/wan"]}},
    {"apiVersion":"net.routerd.net/v1alpha1","kind":"DNSUpstream","metadata":{"name":"wan"},"spec":{"protocol":"udp","addressFrom":[{"resource":"DHCPv4Client/wan","field":"dnsServers"}]}}
  ]}
}
