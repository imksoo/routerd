daemon_args="-P ${daemon_pidfile} -p ${child_pidfile} -t ${name} -r -f -- '/usr/local/sbin/routerd-dns-resolver' 'daemon' '--resource' 'lan-resolver' '--config-file' '/var/db/routerd/dns-resolver/lan-resolver/config.json' '--socket' '/var/run/routerd/dns-resolver/lan-resolver.sock' '--state-file' '/var/db/routerd/dns-resolver/lan-resolver/state.json' '--event-file' '/var/db/routerd/dns-resolver/lan-resolver/events.jsonl'"
start_cmd="${name}_start"
