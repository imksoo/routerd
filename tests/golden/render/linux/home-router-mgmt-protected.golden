add table inet routerd_mss
flush table inet routerd_mss
table inet routerd_mss {
  comment "routerd.owner=routerd routerd.generation=1"
  chain forward {
    type filter hook forward priority mangle; policy accept;
    iifname "ens19" oifname "ppp-home" ip protocol tcp tcp flags syn / syn,rst tcp option maxseg size > 1414 tcp option maxseg size set 1414
    iifname "ens19" oifname "ppp-home" meta nfproto ipv6 tcp flags syn / syn,rst tcp option maxseg size > 1394 tcp option maxseg size set 1394
    iifname "ens19" oifname "ds-lite0" ip protocol tcp tcp flags syn / syn,rst tcp option maxseg size > 1420 tcp option maxseg size set 1420
    iifname "ens19" oifname "ds-lite0" meta nfproto ipv6 tcp flags syn / syn,rst tcp option maxseg size > 1400 tcp option maxseg size set 1400
    iifname "ens19" oifname "ens18" ip protocol tcp tcp flags syn / syn,rst tcp option maxseg size > 1460 tcp option maxseg size set 1460
    iifname "ens19" oifname "ens18" meta nfproto ipv6 tcp flags syn / syn,rst tcp option maxseg size > 1440 tcp option maxseg size set 1440
  }
}
add table ip routerd_nat
flush table ip routerd_nat
table ip routerd_nat {
  comment "routerd.owner=routerd routerd.generation=1"
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    # net.routerd.net/v1alpha1/NAT44Rule/lan-to-internet skipped: egressInterface is resolved by ipv4-default at runtime
  }
}
