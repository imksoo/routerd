{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routerd.net/schemas/release-environment-certification-v1.schema.json",
  "title": "routerd release environment certification manifest",
  "description": "Evidence that the PVE/cloud substrate was certified before routerd release qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "environment",
    "topology",
    "status",
    "issuedAt",
    "expiresAt",
    "providers",
    "certifiers",
    "checks",
    "repairs",
    "run"
  ],
  "properties": {
    "schemaVersion": {
      "const": "release-environment-certification/v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "expired"]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "routerdCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "labsCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["pve", "aws", "azure", "oci"]
      }
    },
    "certifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "certify-pve-substrate.sh",
              "certify-cloud-substrate.sh"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "component", "result", "checkedAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "enum": ["pve", "cloud", "cross-substrate", "tooling"]
          },
          "provider": {
            "type": "string",
            "enum": ["pve", "aws", "azure", "oci"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "skipped"]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "action", "result", "verifiedBy"],
        "properties": {
          "component": {
            "type": "string",
            "enum": ["pve", "cloud", "cross-substrate", "tooling"]
          },
          "provider": {
            "type": "string",
            "enum": ["pve", "aws", "azure", "oci"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
          },
          "verifiedBy": {
            "type": "string",
            "minLength": 1
          },
          "repairedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "qualificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noRepairDuringQualification": {
          "type": "boolean",
          "const": true
        },
        "defaultValidityHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "environment",
        "topology",
        "stateMode",
        "routerdArtifact",
        "labsCommit",
        "providers",
        "tofu",
        "pve",
        "lifecycle"
      ],
      "properties": {
        "schemaVersion": {
          "const": "release-environment-contract/v1"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "stateMode": {
          "type": "string",
          "enum": [
            "fresh-fabric-fresh-state",
            "retained-fabric-retained-state",
            "retained-fabric-certified-repair"
          ]
        },
        "routerdArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "commit", "path", "sha256", "target"],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "labsCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "profile", "region", "authMode"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["pve", "aws", "azure", "oci"]
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "authMode": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tofu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workingDirectory",
            "statePath",
            "variablesPath",
            "lockPath",
            "outputPath"
          ],
          "properties": {
            "workingDirectory": {
              "type": "string",
              "minLength": 1
            },
            "statePath": {
              "type": "string",
              "minLength": 1
            },
            "variablesPath": {
              "type": "string",
              "minLength": 1
            },
            "lockPath": {
              "type": "string",
              "minLength": 1
            },
            "outputPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "datastore",
            "bootSource",
            "underlayBridge",
            "captureBridge",
            "managementAddressSource",
            "vmids"
          ],
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1
            },
            "datastore": {
              "type": "string",
              "minLength": 1
            },
            "bootSource": {
              "type": "string",
              "minLength": 1
            },
            "underlayBridge": {
              "type": "string",
              "minLength": 1
            },
            "captureBridge": {
              "type": "string",
              "minLength": 1
            },
            "managementAddressSource": {
              "type": "string",
              "enum": ["qga-dhcp", "certified-static"]
            },
            "vmids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ttl",
            "heartbeatStale",
            "cleanupScope"
          ],
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[smhd]$"
            },
            "heartbeatStale": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[smhd]$"
            },
            "cleanupScope": {
              "const": "run-id"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
